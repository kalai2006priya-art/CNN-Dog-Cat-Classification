*.tar.gz

# Trained Model Binaries (weights can be >50MB and exceed GitHub limits)
models/*.keras
models/*.h5
models/*.weights.h5

# Keep the models folder tracked via .gitkeep
!models/.gitkeep
!results/.gitkeep

# Environment variables & credentials
.env
.env.*
secrets.json

# Operating System Files
Thumbs.db
Desktop.ini
.DS_Store

# VS Code specific files (except base settings if needed)
.vscode/*
!.vscode/settings.json
